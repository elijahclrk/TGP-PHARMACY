NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Configure a PostgreSQL connection string when database work begins.
# For Neon, use the connection string provided by Neon, including its SSL options.
DATABASE_URL=

# Generate a unique random secret (at least 32 bytes). Never commit the real value.
JWT_SECRET=
JWT_TTL_SECONDS=900
# One-time bootstrap only: supply via environment or .env, then remove immediately.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
