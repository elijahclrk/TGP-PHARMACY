# Future dedicated academic service ONLY. All secrets/target values are blank.
# Keep the existing operational DATABASE_URL and local professor files unchanged.
# Start command: node src/academic-server.js (WORKDIR /app/server in the image).
NODE_ENV=production
ACADEMIC_DEMO_ENABLED=true
ACADEMIC_DEMO_DATABASE_URL=
ACADEMIC_DEMO_MANIFEST_B64=
ACADEMIC_DEMO_PUBLIC_KEY_B64=
CLIENT_ORIGIN=
JWT_SECRET=
JWT_TTL_SECONDS=900
ACADEMIC_DEMO_POOL_MAX=3
# Explicit verified ingress CIDRs only. Blank trusts no forwarded headers.
# Never use 0.0.0.0/0, ::/0, blanket true, or a guessed proxy hop count.
ACADEMIC_DEMO_TRUSTED_PROXY_CIDRS=
CONTROLLED_WORKFLOWS_ENABLED=false
RETURN_RESTOCK_ENABLED=false
PRODUCT_IMAGES_ENABLED=false
TZ=UTC
# Railway supplies PORT. No generic DATABASE_URL or TEST_DATABASE_URL permitted.
